# ─── PostgreSQL ────────────────────────────────────────────────
# Database connection
POSTGRES_USER=myuser
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=mydatabase
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ─── pgAdmin ────────────────────────────────────────────────────
# pgAdmin web interface credentials (http://localhost:8080)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_strong_password_here

# ─── ETL defaults ───────────────────────────────────────────────
# Comma-separated ticker symbols: BTC-USD AAPL MSFT NVDA
TICKERS=BTC-USD
YFINANCE_PERIOD=1mo
YFINANCE_INTERVAL=1d
TARGET_TABLE=finance_daily
